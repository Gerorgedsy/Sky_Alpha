  "bts": {
    "comment": [
      "Reporting Carrier On-Time Performance, one zip per month.",
      "Only the columns below are kept; the published file has over 100."
    ],
    "url_template": "https://transtats.bts.gov/PREZIP/On_Time_Reporting_Carrier_On_Time_Performance_1987_present_{year}_{month}.zip",
    "columns": [
      "FlightDate",
      "Reporting_Airline",
      "Tail_Number",
      "Flight_Number_Reporting_Airline",
      "Origin",
      "Dest",
      "CRSDepTime",
      "DepTime",
      "DepDelay",
      "DepDel15",
      "TaxiOut",
      "WheelsOff",
      "WheelsOn",
      "TaxiIn",
      "CRSArrTime",
      "ArrTime",
      "ArrDelay",
      "ArrDel15",
      "Cancelled",
      "CancellationCode",
      "Diverted",
      "CRSElapsedTime",
      "ActualElapsedTime",
      "Distance",
      "CarrierDelay",
      "WeatherDelay",
      "NASDelay",
      "SecurityDelay",
      "LateAircraftDelay"
    ]
  },
  "opensky": {
    "comment": [
      "Flights by airport are historical (previous day or earlier) and limited",
      "to two days per request. State vectors are live only: anonymous calls",
      "ignore `time`, authenticated ones reach back one hour. A states archive",
      "therefore has to be collected going forward."
    ],
    "api_base": "https://opensky-network.org/api",
    "token_url": "https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token",
    "flights_chunk_hours": 24,
    "states_bbox": {
      "lamin": 24.0,
      "lomin": -125.0,
      "lamax": 50.0,
      "lomax": -66.0
    },
    "states_poll_seconds": 300,
    "hub_radius_km": 40,
    "stale_position_seconds": 60
  },
  "hrrr": {
    "comment": [
      "HRRR CONUS surface fields at the grid point nearest each hub.",
      "One GRIB message covers all 30 hubs, so cost scales with",
      "cycles x leads x fields, not with hubs.",
      "available_after_minutes: a cycle is usually on the archive about",
      "an hour after its nominal time; a forecast made at time t may only use",
      "cycles whose init_time + this lag is at or before t."
    ],
    "url_template": "https://noaa-hrrr-bdp-pds.s3.amazonaws.com/hrrr.{day}/conus/hrrr.t{cycle}z.wrfsfcf{lead:02d}.grib2",
    "cycle_hours_utc": [
      0,
      3,
      6,
      9,
      12,
      15,
      18,
      21
    ],
    "leads": [
      0,
      2,
      4,
      6
    ],
    "available_after_minutes": 60,
    "fields": [
      {
        "name": "REFC",
        "level": "entire atmosphere"
      },
      {
        "name": "VIS",
        "level": "surface"
      },
      {
        "name": "GUST",
        "level": "surface"
      },
      {
        "name": "TMP",
        "level": "2 m above ground"
      },
      {
        "name": "UGRD",
        "level": "10 m above ground"
      },
      {
        "name": "VGRD",
        "level": "10 m above ground"
      },
      {
        "name": "PRATE",
        "level": "surface"
      },
      {
        "name": "HGT",
        "level": "cloud ceiling"
      }
    ]
  }
}